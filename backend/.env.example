# Google Ads API — console.cloud.google.com + ads.google.com/aw/apicenter
GOOGLE_ADS_DEVELOPER_TOKEN=xxx
GOOGLE_ADS_CLIENT_ID=xxx
GOOGLE_ADS_CLIENT_SECRET=xxx
GOOGLE_ADS_LOGIN_CUSTOMER_ID=xxx

# Anthropic — console.anthropic.com/keys
ANTHROPIC_API_KEY=xxx
CLAUDE_SONNET=claude-sonnet-4-6
CLAUDE_HAIKU=claude-haiku-4-5
MAX_TOKENS_PER_REQUEST=2000
ENABLE_PROMPT_CACHING=true

# Supabase — app.supabase.com → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_KEY=xxx

# Redis — Upstash (Railway add-on) o Railway Redis plugin
REDIS_URL=redis://default:xxx@xxx.upstash.io:6379
REDIS_TOKEN_CACHE_TTL=3600

# Stripe — dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_BASICO=price_xxx       # 29€/mes
STRIPE_PRICE_PROFESIONAL=price_xxx  # 79€/mes
STRIPE_PRICE_AGENCIA=price_xxx      # 199€/mes

# Push notifications VAPID — generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=xxx
VAPID_PRIVATE_KEY=xxx
VAPID_EMAIL=hola@adsaipro.com

# Control de coste de IA — se pausa la IA si el coste diario supera este límite (USD)
COSTE_DIARIO_LIMITE=5

# SMTP para alertas de coste (Gmail: usa una App Password, no la contraseña normal)
# Guía: myaccount.google.com → Seguridad → Contraseñas de aplicaciones
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=servitecnic24h@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password de Gmail (16 caracteres)

# App
JWT_SECRET=un-secreto-largo-y-aleatorio-minimo-32-caracteres
FRONTEND_URL=https://adsaipro.com
ADMIN_EMAILS=servitecnic24h@gmail.com
PORT=3001
NODE_ENV=production
