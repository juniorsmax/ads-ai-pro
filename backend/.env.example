SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=servitecnic24h@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx   # App Password de Gmail (16 caracteres)

# PostHog — analytics de comportamiento (server-side)
# Para self-hosting: apunta POSTHOG_HOST a tu instancia
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://eu.i.posthog.com

# Hostinger VPS API — hpanel.hostinger.com → Cuenta → API
# Solo para clientes con VPS Hostinger — dejar vacío si no aplica
