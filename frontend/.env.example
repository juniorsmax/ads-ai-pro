# URL del backend en Railway — sin barra final
VITE_API_URL=https://api.adsaipro.com

# PostHog — app.posthog.com → Project Settings → Project API Key
# Para self-hosting: apunta VITE_POSTHOG_HOST a tu instancia (ej: https://posthog.adsaipro.com)
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Microsoft Clarity — clarity.microsoft.com → Nuevo proyecto → Obtener código
# Solo el Project ID (cadena alfanumérica de ~10 chars)
VITE_CLARITY_PROJECT_ID=xxxxxxxxxx
